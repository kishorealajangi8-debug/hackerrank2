
#include <stdarg.h>
#include <stdio.h>
#include <limits.h>

// Function to calculate the sum of n arguments
int sum(int count, ...) {
    int total = 0;
    va_list args;
    
    // Initialize the argument list
    va_start(args, count);
    
    for (int i = 0; i < count; i++) {
        // Access the next argument of type int
        total += va_arg(args, int);
    }
    
    // Clean up the list
    va_end(args);
    return total;
}

// Function to find the minimum of n arguments
int min(int count, ...) {
    va_list args;
    va_start(args, count);
    
    // Initialize min with the first argument
    int minimum = va_arg(args, int);
    
    for (int i = 1; i < count; i++) {
        int current = va_arg(args, int);
        if (current < minimum) {
            minimum = current;
        }
    }
    
    va_end(args);
    return minimum;
}

// Function to find the maximum of n arguments
int max(int count, ...) {
    va_list args;
    va_start(args, count);
    
    // Initialize max with the first argument
    int maximum = va_arg(args, int);
    
    for (int i = 1; i < count; i++) {
        int current = va_arg(args, int);
        if (current > maximum) {
            maximum = current;
        }
    }
    
    va_end(args);
    return maximum;
}

