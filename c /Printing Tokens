#include <stdio.h>

int main() {
    char str[1000];

    // Read the whole line
    fgets(str, sizeof(str), stdin);

    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ' || str[i] == '\n') {
            printf("\n");
        } else {
            printf("%c", str[i]);
        }
    }

    return 0;
}
