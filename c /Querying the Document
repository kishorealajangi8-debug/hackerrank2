

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <assert.h>

#define MAX_CHARACTERS 1005
#define MAX_PARAGRAPHS 5

// --- Logic to parse the document ---
char**** get_document(char* text) {
    char**** doc = malloc(sizeof(char***));
    int p_idx = 0, s_idx = 0, w_idx = 0;

    doc[p_idx] = malloc(sizeof(char**));
    doc[p_idx][s_idx] = malloc(sizeof(char*));

    char* word_start = text;
    for (int i = 0; ; i++) {
        if (text[i] == ' ' || text[i] == '.' || text[i] == '\n' || text[i] == '\0') {
            // Calculate length and extract word
            int word_len = &text[i] - word_start;
            char* word = malloc(word_len + 1);
            strncpy(word, word_start, word_len);
            word[word_len] = '\0';

            doc[p_idx][s_idx][w_idx++] = word;
            doc[p_idx][s_idx] = realloc(doc[p_idx][s_idx], (w_idx + 1) * sizeof(char*));

            if (text[i] == '.') {
                s_idx++;
                w_idx = 0;
                doc[p_idx] = realloc(doc[p_idx], (s_idx + 1) * sizeof(char**));
                doc[p_idx][s_idx] = malloc(sizeof(char*));
            } 
            else if (text[i] == '\n') {
                p_idx++;
                s_idx = 0;
                w_idx = 0;
                doc = realloc(doc, (p_idx + 1) * sizeof(char***));
                doc[p_idx] = malloc(sizeof(char**));
                doc[p_idx][s_idx] = malloc(sizeof(char*));
            }

            if (text[i] == '\0') break;
            word_start = &text[i+1];
        }
    }
    return doc;
}

// --- Query Functions with exact names from main ---

char* kth_word_in_mth_sentence_of_nth_paragraph(char**** document, int k, int m, int n) {
    // k is word, m is sentence, n is paragraph
    // Note the order of indices based on the function name!
    return document[n-1][m-1][k-1];
}

char** kth_sentence_in_mth_paragraph(char**** document, int k, int m) {
    // k is sentence, m is paragraph
    return document[m-1][k-1];
}

char*** kth_paragraph(char**** document, int k) {
    return document[k-1];
}
